+                idx = 0
+                while True:
+                    found = text_lower.find("c++", idx)
+                    if found == -1:
+                        break
+                    matches.append((found, found + 3))
+                    idx = found + 3
+        else:
+            idx = 0
+            while True:
+                found = text_lower.find(term_lower, idx)
+                if found == -1:
+                    break
+                matches.append((found, found + len(term_lower)))
+                idx = found + len(term_lower)
+
+        if not matches:
+            return False
+
